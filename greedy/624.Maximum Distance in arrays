import java.util.List;

class Solution {
    public int maxDistance(List<List<Integer>> arrays) {

        // Initialize using the first array
        int globalMin = arrays.get(0).get(0);
        List<Integer> first = arrays.get(0);
        int globalMax = first.get(first.size() - 1);

        int ans = 0;

        // Process remaining arrays
        for (int i = 1; i < arrays.size(); i++) {

            List<Integer> current = arrays.get(i);

            int currentMin = current.get(0);
            int currentMax = current.get(current.size() - 1);

            // Compare current array with previous arrays
            ans = Math.max(ans, currentMax - globalMin);
            ans = Math.max(ans, globalMax - currentMin);

            // Update global min and max
            globalMin = Math.min(globalMin, currentMin);
            globalMax = Math.max(globalMax, currentMax);
        }

        return ans;
    }
}
